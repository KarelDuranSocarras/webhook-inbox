# Copy to .env and adjust for your local environment (perfil dev).
# Database
# DB_PORT is the host port published by docker-compose (postgres listens on 5432 in the container).
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/webhookinbox
DB_USER=webhookinbox
DB_PASSWORD=webhookinbox

# Webhook inbox
WEBHOOK_INBOX_MAX_BODY_BYTES=1048576
WEBHOOK_INBOX_TOKEN_LENGTH=24
WEBHOOK_INBOX_DEFAULT_PAGE_SIZE=25
WEBHOOK_INBOX_RETENTION_DAYS=7
WEBHOOK_INBOX_RATE_LIMIT_ENABLED=true
WEBHOOK_INBOX_RATE_LIMIT_REQUESTS_PER_MINUTE=100
