# Copy to .env and adjust for your local environment.
# `docker compose` reads this file automatically.

# Postgres host port published by compose (postgres listens on 5432 inside the container).
DB_PORT=5433
# Application host port.
APP_PORT=8080

# Database (used by the `dev` profile locally and by the `docker` profile in compose).
DB_URL=jdbc:postgresql://localhost:5433/webhookinbox
DB_USER=webhookinbox
DB_PASSWORD=webhookinbox

# Webhook inbox
APP_MAX_BODY_BYTES=1048576
APP_RETENTION_DAYS=7
APP_RETENTION_ENABLED=true
APP_RETENTION_CRON=0 0 * * * *
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_RPM=100

# Optional public base URL used to render ingest URLs (empty = derive from request).
WEBHOOK_INBOX_BASE_URL=